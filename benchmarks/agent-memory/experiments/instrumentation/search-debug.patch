+// ── E-WB: ID-level debug sink (test-only; env-gated) ──
+//
+// `MIND_SEARCH_DEBUG=<path>` makes every `searchMemories` call append one JSONL
+// line with the ordered *memory names* at each pipeline stage. This is a
+// scratch-DB-only diagnostic for the replay workbench; with the env unset the
+// hot path pays only one `process.env` read per search. Enabling it never
+// changes results, ordering, or the public contract.
+
+/**
+ * Upper bound on the emitted `admitted_ranked_final` list. Set far above any
+ * observed admitted-set size so classification is never rank-ambiguous; the
+ * companion `admission_kept`/`admission_dropped` totals prove whether the cap
+ * could have hidden an item.
+ */
+const DEBUG_RANK_CAP = 1000;
+
+/** One query's ordered memory-name sets by pipeline stage (never content). */
+export interface SearchDebugRecord {
+  /** The raw query string (public benchmark question; scratch DB only). */
+  q: string;
+  /** Ordered names per channel (rank order within each channel). */
+  candidates_by_channel: Record<string, string[]>;
+  /** Ordered names after the coverage floor, per rung/channel. */
+  after_coverage_by_rung: Record<string, string[]>;
+  /** Ordered names remaining after NOT exclusions. */
+  after_not: string[];
+  /** Ordered names removed by NOT exclusions (from the candidate set). */
+  excluded_by_not: string[];
+  /** Ordered names admitted by the strict boolean predicate, before relaxation. */
+  admitted_strict: string[];
+  /** Final fused rank order (uncapped up to DEBUG_RANK_CAP). */
+  admitted_ranked_final: string[];
+  /** Admission gate totals, so a capped list is never ambiguous on its own. */
+  admission_kept: number;
+  admission_dropped: number;
+  zero_reason: 'empty_query' | 'no_rungs' | 'no_candidates' | null;
+  admission_tier: 'strict' | 'relaxed' | 'last_resort';
+}
+
+export type SearchDebugSink = (record: SearchDebugRecord) => void;
+
+/** Append a JSONL debug record when `MIND_SEARCH_DEBUG` names a file. */
+function activeDebugSink(): SearchDebugSink | null {
+  const path = process.env.MIND_SEARCH_DEBUG;
+  if (!path) return null;
+  return (record: SearchDebugRecord): void => {
+    appendFileSync(path, `${JSON.stringify(record)}\n`);
+  };
+}
