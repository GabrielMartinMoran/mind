{
  "compilerOptions": {
    "lib": ["ESNext", "dom"],
    "types": ["bun"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "allowJs": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src/**/*", "test/**/*", "experiments/**/*", "probes/*.ts"],
  // The experiments and the MCP stdio probe predate this subproject tsconfig
  // (the root project never typechecked them) and carry long-standing
  // pre-existing type errors unrelated to the benchmark isolation task. They
  // are runnable but are not typechecked here. The root ESLint config lints the
  // experiments with a non-type-aware pass; the probes are neither linted nor
  // typechecked.
  "exclude": ["node_modules", "probes/sdk-probe", "experiments/**/*", "probes/mcp-stdio-probe.ts"]
}
