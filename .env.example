# ═══════════════════════════════════════════════════════════════════════════════
# mind — Persistent memory for agents and humans
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Storage ────────────────────────────────────────────────────────────────────

# Directory where the SQLite database (mind.db) is stored.
# Default: ./data (relative to project root)
# MIND_DATA_DIR=./data

# Full path to the SQLite database file (overrides MIND_DATA_DIR + mind.db).
# Useful for testing with temporary databases.
# MIND_DB_PATH=/tmp/mind-test.db

# ─── Web Server ─────────────────────────────────────────────────────────────────

# Port for the web server (default: 30303)
# MIND_PORT=30303

# ─── RAG / Semantic Search (optional) ─────────────────────────────────────────

# Enable semantic search with embeddings.
# When true, memories get a 1536-dim embedding stored in SQLite.
# Search blends FTS results with cosine similarity scores.
# MIND_RAG=true

# Embedding provider for RAG: openai (default) or openrouter.
# Values are matched case-insensitively; an invalid value disables RAG
# without falling back to another provider.
# MIND_EMBEDDING_PROVIDER=openai

# OpenAI API key (required for the openai provider; text-embedding-3-small).
# Get yours at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# OpenRouter API key (required for the openrouter provider;
# openai/text-embedding-3-small model).
# Get yours at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# ─── Logging ───────────────────────────────────────────────────────────────────

# Log retention in minutes (default: 10080 = 7 days)
# MIND_LOG_RETENTION_MINUTES=10080
